"""
xdg-open-switchbar: Shadow xdg-open to route URLs to Brave Browser profiles.

Install at ~/.local/bin/xdg-open to intercept all desktop URL opens.
Config: ~/.config/switchbar/switchbar-rules.json
Log:    ~/.local/share/xdg-open-switchbar/switchbar.log (when XDG_SWITCHBAR_DEBUG=1)
"""

import json
import logging
import os
import re
import subprocess
import sys
from urllib.parse import urlparse

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

REAL_XDG_OPEN = "/usr/bin/xdg-open"
CONFIG_PATH = os.path.expanduser("~/.config/switchbar/switchbar-rules.json")
LOG_DIR = os.path.expanduser("~/.local/share/xdg-open-switchbar")
LOG_PATH = os.path.join(LOG_DIR, "switchbar.log")
DEBUG = os.environ.get("XDG_SWITCHBAR_DEBUG", "0") == "1"

# Detect WSL — on WSL the real xdg-open already delegates to Windows/Switchbar
_IS_WSL = (
    "microsoft" in open("/proc/version").read().lower()
    if os.path.exists("/proc/version")
    else False
)

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------


def _setup_logging() -> logging.Logger:
    logger = logging.getLogger("xdg-open-switchbar")
    if not DEBUG:
        logger.addHandler(logging.NullHandler())
        return logger
    os.makedirs(LOG_DIR, exist_ok=True)
    handler = logging.FileHandler(LOG_PATH)
    handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
    logger.addHandler(handler)
    logger.setLevel(logging.DEBUG)
    return logger


log = _setup_logging()

# ---------------------------------------------------------------------------
# Config loading
# ---------------------------------------------------------------------------


def load_config(path: str) -> dict | None:
    """Load and return the switchbar config, or None on failure."""
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        log.warning("Config not found: %s", path)
        return None
    except json.JSONDecodeError as exc:
        log.warning("Config parse error in %s: %s", path, exc)
        return None


# ---------------------------------------------------------------------------
# Rule matching
# ---------------------------------------------------------------------------


def _hostname_matches(pattern: str, hostname: str) -> bool:
    """
    Match a rule value against a URL hostname.

    Supports:
    - Exact match:    "hp.zoom.us"  matches "hp.zoom.us"
    - Wildcard prefix: "*.apps.cavanaughs.org" matches any subdomain
    """
    pattern = pattern.lower()
    hostname = hostname.lower()
    if pattern.startswith("*."):
        suffix = pattern[1:]  # ".apps.cavanaughs.org"
        return hostname.endswith(suffix) or hostname == pattern[2:]
    return hostname == pattern


def _url_matches(pattern: str, url: str) -> bool:
    """Match a rule value (regex pattern) against the full URL."""
    try:
        return bool(re.match(pattern, url, re.IGNORECASE))
    except re.error:
        # Treat broken patterns as no-match
        log.warning("Invalid regex in url rule: %s", pattern)
        return False


def find_matching_rule(
    url: str, rules: list[dict], profiles: dict[str, str]
) -> tuple[dict | None, str | None, bool]:
    """
    Return (rule, brave_profile_dir, prompt) for the first matching rule.

    - type="profile" with known profileId  → (rule, profile_dir, False)
    - actionType="promptSelection"          → (rule, None, True)
    - no match                             → (None, None, False)
    """
    parsed = urlparse(url)
    hostname = parsed.hostname or ""

    for rule in rules:
        value_type = rule.get("valueType", "hostname")
        value = rule.get("value", "")

        # Check if this rule matches the URL at all
        matched = False
        if value_type == "hostname":
            matched = _hostname_matches(value, hostname)
        elif value_type == "url":
            matched = _url_matches(value, url)

        if not matched:
            continue

        # promptSelection rules — show profile picker
        if rule.get("actionType") == "promptSelection":
            log.debug("Matched promptSelection rule %s (value=%s)", rule.get("id", "?"), value)
            return rule, None, True

        # profile rules — dispatch to specific profile
        if rule.get("type") == "profile":
            profile_id = rule.get("profileId", "")
            if not profile_id:
                continue
            profile_dir = profiles.get(profile_id)
            if profile_dir is None:
                log.warning(
                    "Unknown profileId %s in rule %s — skipping",
                    profile_id,
                    rule.get("id", "?"),
                )
                continue
            return rule, profile_dir, False

    return None, None, False


# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------


def _brave_profile_data_dir() -> str:
    """Return the Brave profile data directory."""
    flatpak_path = os.path.expanduser(
        "~/.var/app/com.brave.Browser/config/BraveSoftware/Brave-Browser"
    )
    native_path = os.path.expanduser("~/.config/BraveSoftware/Brave-Browser")
    if os.path.isdir(flatpak_path):
        return flatpak_path
    return native_path


def load_brave_profile_metadata() -> dict[str, dict]:
    """
    Read Brave's Local State to get per-profile display name and highlight color.

    Returns dict keyed by profile directory name:
      { "Default": { "name": "JOHN", "color": "#1f1f23", "text_color": "#ffffff" }, ... }
    """
    local_state = os.path.join(_brave_profile_data_dir(), "Local State")
    try:
        with open(local_state, encoding="utf-8") as f:
            data = json.load(f)
    except Exception as exc:
        log.warning("Could not read Brave Local State: %s", exc)
        return {}

    # Static color overrides — Brave's Local State colors don't match the
    # visible avatar images; use hand-picked colors that match the UI.
    COLOR_OVERRIDES: dict[str, tuple[str, str]] = {
        "Default": ("#f5b400", "#202124"),  # JOHN — golden yellow, dark text
        "HP":      ("#1a73e8", "#ffffff"),   # HP   — Google blue, white text
    }

    result = {}
    cache = data.get("profile", {}).get("info_cache", {})
    for dir_name, info in cache.items():
        if dir_name in COLOR_OVERRIDES:
            bg, fg = COLOR_OVERRIDES[dir_name]
        else:
            raw_color = info.get("profile_highlight_color", 0)
            # Chromium stores as signed 32-bit ARGB int
            val = raw_color & 0xFFFFFFFF
            r = (val >> 16) & 0xFF
            g = (val >> 8) & 0xFF
            b = val & 0xFF
            bg = f"#{r:02x}{g:02x}{b:02x}"
            luminance = 0.299 * r + 0.587 * g + 0.114 * b
            fg = "#ffffff" if luminance < 140 else "#202124"
        result[dir_name] = {
            "name": info.get("name", dir_name),
            "color": bg,
            "text_color": fg,
        }
    return result
    """Return the base command to launch Brave Browser."""
    # Prefer native binary; fall back to Flatpak
    import shutil
    if shutil.which("brave-browser"):
        return ["brave-browser"]
    return ["flatpak", "run", "com.brave.Browser"]


def dispatch_brave(url: str, profile_dir: str) -> None:
    """Launch Brave Browser with the given profile directory and URL."""
    cmd = _brave_cmd() + [f"--profile-directory={profile_dir}", url]
    log.debug("Dispatching to Brave: %s", cmd)
    subprocess.Popen(cmd)


def dispatch_brave_no_profile(url: str) -> None:
    """Launch Brave Browser without specifying a profile, triggering Brave's picker."""
    cmd = _brave_cmd() + [url]
    log.debug("Dispatching to Brave (no profile): %s", cmd)
    subprocess.Popen(cmd)


def prompt_and_dispatch(url: str, profiles: dict[str, str]) -> None:
    """Show the switchbar-prompt profile picker and dispatch to the chosen profile."""
    # Unique profile dirs (excluding 'default' key)
    seen = set()
    profile_dirs = []
    for key, dir_name in profiles.items():
        if key != "default" and dir_name not in seen:
            seen.add(dir_name)
            profile_dirs.append(dir_name)

    if not profile_dirs:
        log.warning("No profiles available for prompt — launching without profile")
        dispatch_brave_no_profile(url)
        return

    # Load display names and colors from Brave's Local State
    brave_meta = load_brave_profile_metadata()

    # Build args: dir:Name:color:text_color
    profile_args = []
    for dir_name in profile_dirs:
        meta = brave_meta.get(dir_name, {})
        display_name = meta.get("name", dir_name)
        color = meta.get("color", "#1a73e8")
        text_color = meta.get("text_color", "#ffffff")
        profile_args.append(f"{dir_name}:{display_name}:{color}:{text_color}")

    # Find switchbar-prompt alongside this script
    script_dir = os.path.dirname(os.path.realpath(__file__))
    prompt_bin = os.path.join(script_dir, "switchbar-prompt")
    if not os.path.exists(prompt_bin):
        # Fall back to PATH
        import shutil
        prompt_bin = shutil.which("switchbar-prompt") or prompt_bin

    cmd = [prompt_bin, url] + profile_args
    log.debug("Launching profile picker: %s", cmd)

    try:
        result = subprocess.run(cmd, capture_output=True, text=True)
        chosen = result.stdout.strip()
        if not chosen:
            log.debug("User cancelled profile picker — no action")
            return
        log.debug("User chose profile: %s", chosen)
        dispatch_brave(url, chosen)
    except FileNotFoundError:
        log.warning("switchbar-prompt not found — launching without profile")
        dispatch_brave_no_profile(url)


def fallthrough(args: list[str]) -> None:
    """Exec the real xdg-open with the original arguments."""
    log.debug("Falling through to %s %s", REAL_XDG_OPEN, args)
    os.execv(REAL_XDG_OPEN, [REAL_XDG_OPEN] + args)


# ---------------------------------------------------------------------------
# Main entry point
# ---------------------------------------------------------------------------


def main(argv: list[str]) -> None:
    args = argv[1:]

    if not args:
        # No arguments: just pass through
        fallthrough(args)

    url = args[0]
    log.debug("Invoked with: %s", url)

    # On WSL, defer entirely to the real xdg-open (which routes through Windows/Switchbar)
    if _IS_WSL:
        log.debug("WSL detected — falling through to %s", REAL_XDG_OPEN)
        fallthrough(args)

    parsed = urlparse(url)
    is_http = parsed.scheme in ("http", "https")

    # Load config (needed for rule matching regardless of scheme)
    config = load_config(CONFIG_PATH)

    # For non-HTTP/HTTPS, only continue if a rule explicitly matches;
    # otherwise fall through to real xdg-open immediately.
    if not is_http:
        if config is None:
            log.debug("Non-HTTP/HTTPS scheme '%s' and no config — falling through", parsed.scheme)
            fallthrough(args)
        rules = config.get("rules", [])
        profiles = config.get("profiles", {})
        rule, profile_dir, prompt = find_matching_rule(url, rules, profiles)
        if rule is None and not prompt:
            log.debug("Non-HTTP/HTTPS scheme '%s', no rule matched — falling through", parsed.scheme)
            fallthrough(args)
        # A rule matched — fall through to dispatch logic below
    else:
        if config is None:
            log.debug("No usable config — falling through")
            fallthrough(args)
        rules = config.get("rules", [])
        profiles = config.get("profiles", {})
        rule, profile_dir, prompt = find_matching_rule(url, rules, profiles)

    if prompt:
        log.debug("promptSelection rule matched — showing profile picker")
        prompt_and_dispatch(url, profiles)
    elif rule is not None:
        log.debug(
            "Matched rule %s (value=%s) → profile dir '%s'",
            rule.get("id", "?"),
            rule.get("value", "?"),
            profile_dir,
        )
        dispatch_brave(url, profile_dir)
    else:
        # No rule matched (HTTP/HTTPS) — use default profile if configured, else launch without profile
        default_profile_dir = config.get("profiles", {}).get("default")
        if default_profile_dir:
            log.debug("No rule matched — dispatching to default profile '%s'", default_profile_dir)
            dispatch_brave(url, default_profile_dir)
        else:
            log.debug("No rule matched — launching Brave without profile (picker)")
            dispatch_brave_no_profile(url)


if __name__ == "__main__":
    try:
        main(sys.argv)
    except Exception as exc:  # pylint: disable=broad-except
        # Last-resort safety net: never crash the desktop, just fall through
        try:
            log.exception("Unexpected error: %s", exc)
        except Exception:
            pass
        os.execv(REAL_XDG_OPEN, [REAL_XDG_OPEN] + sys.argv[1:])
